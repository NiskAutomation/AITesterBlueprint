{
  "version": 2,
  "name": "NiskJiraBuddy",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "JIRA_EMAIL": "nishikantpradhan1996@gmail.com",
    "JIRA_BASE_URL": "https://nishikantpradhan1996.atlassian.net/",
    "GROQ_KEY": "your-groq-api-key-here",
    "GROQ_MODEL": "openai/gpt-oss-120b"
  }
}
